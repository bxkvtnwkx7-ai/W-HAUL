-- CONFIG
local CONFIG = {
  chest = "minecraft:chest_430",
  trash = "minecraft:chest_431",
  redstone = "redstone_integrator_4058",
  openTime = 5,
  priceHash = nil
}

-- PRICE TABLE (NBT IDs)
local PRICE_TABLE = {
  ["dd703d"] = 1000,
  ["e61758"] = 5000,
  ["1fafe1"] = 10000,
  ["6d281b"] = 15000
}

--------------------------------------------------
-- REDSTONE CONTROL
--------------------------------------------------
local function openDoor()
  local rs = peripheral.wrap(CONFIG.redstone)
  if rs then rs.setOutput(true) end
end

local function closeDoor()
  local rs = peripheral.wrap(CONFIG.redstone)
  if rs then rs.setOutput(false) end
end

closeDoor()

--------------------------------------------------
-- NBT HANDLING
--------------------------------------------------
local function getHash(item)
  if not item or not item.nbt then return nil end
  return item.nbt
end

--------------------------------------------------
-- CHEST SCAN
--------------------------------------------------
local function scanChest()
  local inv = peripheral.wrap(CONFIG.chest)
  if not inv then return nil end

  for slot, _ in pairs(inv.list()) do
    local item = inv.getItemDetail(slot, true)
    if item then
      return item, slot
    end
  end

  return nil
end

--------------------------------------------------
-- VALIDATION
--------------------------------------------------
local function isValid(item)
  return getHash(item) == CONFIG.priceHash
end

--------------------------------------------------
-- AUTO CLEAN SYSTEM
--------------------------------------------------
local function clearInvalidItems()
  local inv = peripheral.wrap(CONFIG.chest)
  if not inv then return end

  for slot, _ in pairs(inv.list()) do
    local item = inv.getItemDetail(slot, true)

    if item then
      local id = getHash(item)

      if id ~= CONFIG.priceHash
        and id ~= "dd703d"
        and id ~= "e61758"
        and id ~= "1fafe1"
        and id ~= "6d281b" then

        inv.pushItems(CONFIG.trash, slot, item.count)
      end
    end
  end
end

--------------------------------------------------
-- ADMIN PRICE SETTING
--------------------------------------------------
local function setRoomPrice()
  term.clear()
  term.setCursorPos(1,1)

  print("SET ROOM PRICE")
  print("1 - 1000")
  print("2 - 5000")
  print("3 - 10000")
  print("4 - 15000")

  local choice = read()

  local map = {
    ["1"] = "dd703d",
    ["2"] = "e61758",
    ["3"] = "1fafe1",
    ["4"] = "6d281b"
  }

  local selected = map[choice]

  if selected then
    CONFIG.priceHash = selected
    print("Room price set to: " .. PRICE_TABLE[selected])
  else
    print("Invalid selection")
  end

  sleep(1)
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------
local function runLoop()
  while true do
    closeDoor()

    clearInvalidItems()

    local item, slot = scanChest()

    if item and CONFIG.priceHash then
      if isValid(item) then

        local inv = peripheral.wrap(CONFIG.chest)
        if inv then
          inv.pushItems(CONFIG.chest, slot, item.count, 1)
        end

        openDoor()
        sleep(CONFIG.openTime)
        closeDoor()
      end
    end

    sleep(0.2)
  end
end

--------------------------------------------------
-- ADMIN MENU
--------------------------------------------------
local function adminMenu()
  while true do
    term.clear()
    term.setCursorPos(1,1)

    print("ROOM CONTROLLER")
    print("----------------")
    print("1 - Open Door")
    print("2 - Close Door")
    print("3 - Set Room Price")
    print("4 - Exit")

    local input = read()

    if input == "1" then
      openDoor()

    elseif input == "2" then
      closeDoor()

    elseif input == "3" then
      setRoomPrice()

    elseif input == "4" then
      break
    end
  end
end

--------------------------------------------------
-- STARTUP
--------------------------------------------------
parallel.waitForAny(
  runLoop,
  adminMenu
)
