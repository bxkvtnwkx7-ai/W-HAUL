--------------------------------------------------
-- PRICE TABLE
--------------------------------------------------
local PRICE_TABLE = {
  ["dd703d"] = 1000,
  ["e61758"] = 5000,
  ["1fafe1"] = 10000,
  ["6d281b"] = 15000
}

--------------------------------------------------
-- INVENTORIES
--------------------------------------------------
local CHEST = nil
local TRASH = nil

local function findInventories()
  local names = peripheral.getNames()
  local invs = {}

  for _, name in ipairs(names) do
    local p = peripheral.wrap(name)
    if p and type(p.list) == "function" then
      table.insert(invs, name)
    end
  end

  if #invs < 2 then
    error("Need at least 2 inventories (chest + trash)")
  end

  CHEST = invs[1]
  TRASH = invs[2]
end

findInventories()

--------------------------------------------------
-- DOOR STATE (MODE A)
--------------------------------------------------
local doorState = false

local function openDoor()
  if not doorState then
    redstone.setOutput("left", true)
    doorState = true
  end
end

local function closeDoor()
  if doorState then
    redstone.setOutput("left", false)
    doorState = false
  end
end

closeDoor()

--------------------------------------------------
-- SLOT CACHE (ZERO NBT SPAM SYSTEM)
--------------------------------------------------
local slotCache = {}

local function getSlotHash(inv, slot)
  local cached = slotCache[slot]

  if cached then return cached end

  local detail = inv.getItemDetail(slot)
  if not detail or not detail.nbt then return nil end

  local hash = textutils.serialize(detail.nbt)
  slotCache[slot] = hash

  return hash
end

local function invalidateSlot(slot)
  slotCache[slot] = nil
end

--------------------------------------------------
-- PRICE STATE
--------------------------------------------------
local CONFIG_PRICE = nil

local function setRoomPrice()
  term.clear()
  term.setCursorPos(1,1)

  print("SET ROOM PRICE")
  print("1 - 1000")
  print("2 - 5000")
  print("3 - 10000")
  print("4 - 15000")

  local choice = read()

  local map = {
    ["1"] = "dd703d",
    ["2"] = "e61758",
    ["3"] = "1fafe1",
    ["4"] = "6d281b"
  }

  CONFIG_PRICE = map[choice]

  if CONFIG_PRICE then
    print("Price set: " .. PRICE_TABLE[CONFIG_PRICE])
  else
    print("Invalid selection")
  end

  sleep(1)
end

--------------------------------------------------
-- VALIDATION
--------------------------------------------------
local function isValid(inv, slot)
  local hash = getSlotHash(inv, slot)
  return hash == CONFIG_PRICE
end

--------------------------------------------------
-- CLEAN SYSTEM (SAFE + FAST)
--------------------------------------------------
local function clearInvalidItems()
  local inv = peripheral.wrap(CHEST)
  if not inv then return end

  local items = inv.list()

  for slot, item in pairs(items) do
    if item then
      local hash = getSlotHash(inv, slot)

      if hash
        and hash ~= CONFIG_PRICE
        and not PRICE_TABLE[hash] then

        inv.pushItems(TRASH, slot, item.count)
        invalidateSlot(slot)
      end
    end
  end
end

--------------------------------------------------
-- SCAN (NO HEAVY NBT CALLS)
--------------------------------------------------
local function scanChest()
  local inv = peripheral.wrap(CHEST)
  if not inv then return nil end

  for slot, item in pairs(inv.list()) do
    if item then
      return inv, slot
    end
  end

  return nil
end

--------------------------------------------------
-- MAIN LOOP (OPTIMIZED)
--------------------------------------------------
local function runLoop()
  while true do
    clearInvalidItems()

    local inv, slot = scanChest()

    if inv and slot and CONFIG_PRICE then
      if isValid(inv, slot) then

        local item = inv.getItemDetail(slot)
        if item then
          inv.pushItems(CHEST, slot, item.count, 1)
        end

        openDoor()
      end
    end

    sleep(0.2)
  end
end

--------------------------------------------------
-- ADMIN MENU
--------------------------------------------------
local function adminMenu()
  while true do
    term.clear()
    term.setCursorPos(1,1)

    print("ROOM CONTROLLER")
    print("----------------")
    print("1 - Open Door")
    print("2 - Close Door")
    print("3 - Set Price")
    print("4 - Exit")

    local input = read()

    if input == "1" then
      openDoor()

    elseif input == "2" then
      closeDoor()

    elseif input == "3" then
      setRoomPrice()

    elseif input == "4" then
      break
    end
  end
end

--------------------------------------------------
-- START
--------------------------------------------------
parallel.waitForAny(
  runLoop,
  adminMenu
)
