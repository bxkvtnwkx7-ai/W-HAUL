--------------------------------------------------
-- PRICE TABLE (UNCHANGED)
--------------------------------------------------
local PRICE_TABLE = {
  ["dd703d"] = 1000,
  ["e61758"] = 5000,
  ["1fafe1"] = 10000,
  ["6d281b"] = 15000
}

--------------------------------------------------
-- AUTO DETECT CHESTS ONLY
--------------------------------------------------
local CHEST = nil
local TRASH = nil

local function detectPeripherals()
  local names = peripheral.getNames()

  for _, name in ipairs(names) do
    local t = peripheral.getType(name)

    if t == "minecraft:chest" then
      if not CHEST then
        CHEST = name
      elseif not TRASH and name ~= CHEST then
        TRASH = name
      end
    end
  end
end

detectPeripherals()

if not CHEST then error("No chest detected") end
if not TRASH then error("No trash chest detected") end

--------------------------------------------------
-- REDSTONE CONTROL (LEFT SIDE)
--------------------------------------------------
local function openDoor()
  redstone.setOutput("left", true)
end

local function closeDoor()
  redstone.setOutput("left", false)
end

closeDoor()

--------------------------------------------------
-- NBT HASH
--------------------------------------------------
local function getHash(item)
  if not item or not item.nbt then return nil end
  return item.nbt
end

--------------------------------------------------
-- CHEST SCAN
--------------------------------------------------
local function scanChest()
  local inv = peripheral.wrap(CHEST)
  if not inv then return nil end

  for slot, _ in pairs(inv.list()) do
    local item = inv.getItemDetail(slot, true)
    if item then
      return item, slot
    end
  end

  return nil
end

--------------------------------------------------
-- VALIDATION
--------------------------------------------------
local CONFIG_PRICE = nil

local function isValid(item)
  return getHash(item) == CONFIG_PRICE
end

--------------------------------------------------
-- SET PRICE (ADMIN)
--------------------------------------------------
local function setRoomPrice()
  term.clear()
  term.setCursorPos(1,1)

  print("SET ROOM PRICE")
  print("1 - 1000")
  print("2 - 5000")
  print("3 - 10000")
  print("4 - 15000")

  local choice = read()

  local map = {
    ["1"] = "dd703d",
    ["2"] = "e61758",
    ["3"] = "1fafe1",
    ["4"] = "6d281b"
  }

  CONFIG_PRICE = map[choice]

  if CONFIG_PRICE then
    print("Price set.")
  else
    print("Invalid selection")
  end

  sleep(1)
end

--------------------------------------------------
-- AUTO CLEAN INVALID ITEMS
--------------------------------------------------
local function clearInvalidItems()
  local inv = peripheral.wrap(CHEST)
  if not inv then return end

  for slot, _ in pairs(inv.list()) do
    local item = inv.getItemDetail(slot, true)

    if item then
      local id = getHash(item)

      if id ~= CONFIG_PRICE
        and id ~= "dd703d"
        and id ~= "e61758"
        and id ~= "1fafe1"
        and id ~= "6d281b" then

        inv.pushItems(TRASH, slot, item.count)
      end
    end
  end
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------
local function runLoop()
  while true do
    closeDoor()

    clearInvalidItems()

    local item, slot = scanChest()

    if item and CONFIG_PRICE then
      if isValid(item) then

        local inv = peripheral.wrap(CHEST)
        if inv then
          inv.pushItems(CHEST, slot, item.count, 1)
        end

        openDoor()
        sleep(5)
        closeDoor()
      end
    end

    sleep(0.2)
  end
end

--------------------------------------------------
-- ADMIN MENU
--------------------------------------------------
local function adminMenu()
  while true do
    term.clear()
    term.setCursorPos(1,1)

    print("ROOM CONTROLLER")
    print("1 - Open Door")
    print("2 - Close Door")
    print("3 - Set Price")
    print("4 - Exit")

    local input = read()

    if input == "1" then
      openDoor()

    elseif input == "2" then
      closeDoor()

    elseif input == "3" then
      setRoomPrice()

    elseif input == "4" then
      break
    end
  end
end

--------------------------------------------------
-- START
--------------------------------------------------
parallel.waitForAny(
  runLoop,
  adminMenu
)
