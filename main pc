-- CONFIG
local CONFIG = {
  hopperSide = "right",
  doorSide = "back",
  openTime = 5,
  priceValue = nil
}

-- NBT PRICE TABLE (your system)
local PRICE_TABLE = {
  ["dd703d"] = 1000,
  ["e61758"] = 5000,
  ["1fafe1"] = 10000,
  ["6d281b"] = 15000
}

-- SAFETY: always start closed
local function closeDoor()
  redstone.setOutput(CONFIG.doorSide, false)
end

local function openDoor()
  redstone.setOutput(CONFIG.doorSide, true)
end

closeDoor()

-- GET ITEM NBT ID
local function getHash(item)
  if not item or not item.nbt then return nil end
  return item.nbt
end

-- SCAN HOPPER
local function scanHopper()
  local inv = peripheral.wrap(CONFIG.hopperSide)
  if not inv then return nil end

  for slot, _ in pairs(inv.list()) do
    local item = inv.getItemDetail(slot, true)
    if item then
      return item, slot
    end
  end

  return nil
end

-- SET PRICE ITEM
local function setPrice()
  print("Drop PRICE BOOK into hopper, press ENTER")
  read()

  local item = scanHopper()

  if item then
    local id = getHash(item)
    CONFIG.priceValue = PRICE_TABLE[id]

    if CONFIG.priceValue then
      print("Price set to: " .. CONFIG.priceValue)
    else
      print("Invalid book.")
      CONFIG.priceValue = nil
    end
  else
    print("No item detected.")
  end

  sleep(1)
end

-- CHECK PAYMENT
local function isValid(item)
  local id = getHash(item)
  return PRICE_TABLE[id] ~= nil
end

-- MAIN LOOP
local function runLoop()
  while true do
    closeDoor()

    local item, slot = scanHopper()

    if item and isValid(item) then
      local inv = peripheral.wrap(CONFIG.hopperSide)

      if inv then
        inv.pushItems(CONFIG.hopperSide, slot, 1, 1)
      end

      openDoor()
      sleep(CONFIG.openTime)
      closeDoor()
    end

    sleep(0.2)
  end
end

-- ADMIN MENU
local function adminMenu()
  while true do
    term.clear()
    term.setCursorPos(1,1)

    print("ROOM CONTROLLER")
    print("----------------")
    print("1 - Open Door")
    print("2 - Close Door")
    print("3 - Set Price Book")
    print("4 - Exit")

    local input = read()

    if input == "1" then
      openDoor()

    elseif input == "2" then
      closeDoor()

    elseif input == "3" then
      setPrice()

    elseif input == "4" then
      break
    end
  end
end

-- STARTUP
parallel.waitForAny(
  runLoop,
  adminMenu
)
