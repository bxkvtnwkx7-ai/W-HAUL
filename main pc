--------------------------------------------------
-- HARD BOUND INVENTORIES
--------------------------------------------------
local CHEST_NAME = "minecraft:ironchest_obsidian_155"
local TRASH_NAME = "minecraft:ironchest_obsidian_156"

local CHEST = peripheral.wrap(CHEST_NAME)
local TRASH = peripheral.wrap(TRASH_NAME)

if not CHEST then error("Missing CHEST") end
if not TRASH then error("Missing TRASH") end

--------------------------------------------------
-- PRICE TABLE (NBT HASH PREFIXES)
--------------------------------------------------
local PRICE_TABLE = {
  ["dd703d"] = 1000,
  ["e61758"] = 5000,
  ["1fafe1"] = 10000,
  ["6d281b"] = 15000
}

--------------------------------------------------
-- DOOR STATE
--------------------------------------------------
local doorState = false

local function openDoor()
  if not doorState then
    redstone.setOutput("left", true)
    doorState = true
  end
end

local function closeDoor()
  if doorState then
    redstone.setOutput("left", false)
    doorState = false
  end
end

closeDoor()

--------------------------------------------------
-- ROOM PRICE
--------------------------------------------------
local CONFIG_PRICE_VALUE = nil

local function setRoomPrice()
  term.clear()
  term.setCursorPos(1,1)

  print("SET ROOM PRICE")
  print("1 - 1000")
  print("2 - 5000")
  print("3 - 10000")
  print("4 - 15000")

  local choice = read()

  local map = {
    ["1"] = 1000,
    ["2"] = 5000,
    ["3"] = 10000,
    ["4"] = 15000
  }

  CONFIG_PRICE_VALUE = map[choice]

  print("Set price:", CONFIG_PRICE_VALUE or "INVALID")
  sleep(1)
end

--------------------------------------------------
-- SAFE NBT PREFIX (DEBUG FRIENDLY)
--------------------------------------------------
local function getPrefix(item)
  if not item then return nil end

  if item.nbtHash then
    return string.sub(item.nbtHash, 1, 6)
  end

  if item.nbt then
    local s = textutils.serialize(item.nbt)
    return string.sub(s, 1, 6)
  end

  return nil
end

--------------------------------------------------
-- VALIDATION
--------------------------------------------------
local function isValid(item)
  local prefix = getPrefix(item)

  print("DEBUG prefix:", prefix or "nil")
  print("DEBUG price set:", CONFIG_PRICE_VALUE or "nil")

  if not prefix then return false end
  if not CONFIG_PRICE_VALUE then return false end

  return PRICE_TABLE[prefix] == CONFIG_PRICE_VALUE
end

--------------------------------------------------
-- CLEAN INVALID ITEMS
--------------------------------------------------
local function clearInvalidItems()
  for slot, item in pairs(CHEST.list()) do
    if item then
      local prefix = getPrefix(item)

      if prefix and not PRICE_TABLE[prefix] then
        CHEST.pushItems(TRASH_NAME, slot, item.count)
      end
    end
  end
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------
local function runLoop()
  while true do
    term.clear()
    term.setCursorPos(1,1)

    print("ROOM DOOR SYSTEM")
    print("-----------------")

    print("Price:", CONFIG_PRICE_VALUE or "NOT SET")

    clearInvalidItems()

    for slot, item in pairs(CHEST.list()) do
      if item then
        print("Slot:", slot)

        local valid = isValid(item)

        if valid then
          print("STATUS: ACCEPTED")
          CHEST.pushItems(CHEST_NAME, slot, item.count)
          openDoor()
        else
          print("STATUS: REJECTED")
        end
      end
    end

    sleep(0.5)
  end
end

--------------------------------------------------
-- ADMIN MENU
--------------------------------------------------
local function adminMenu()
  while true do
    term.clear()
    term.setCursorPos(1,1)

    print("ROOM CONTROLLER")
    print("1 - Open Door")
    print("2 - Close Door")
    print("3 - Set Price")
    print("4 - Exit")

    local input = read()

    if input == "1" then openDoor()
    elseif input == "2" then closeDoor()
    elseif input == "3" then setRoomPrice()
    elseif input == "4" then break end
  end
end

--------------------------------------------------
-- START
--------------------------------------------------
parallel.waitForAny(runLoop, adminMenu)
