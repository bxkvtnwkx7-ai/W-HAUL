--------------------------------------------------
-- HARD BOUND INVENTORIES
--------------------------------------------------
local CHEST_NAME = "minecraft:chest_430"
local TRASH_NAME = "minecraft:chest_431"

local CHEST = peripheral.wrap(CHEST_NAME)
local TRASH = peripheral.wrap(TRASH_NAME)

if not CHEST then
  error("Missing CHEST: " .. CHEST_NAME)
end

if not TRASH then
  error("Missing TRASH: " .. TRASH_NAME)
end

--------------------------------------------------
-- PRICE TABLE (NBT HASH PREFIXES)
--------------------------------------------------
local PRICE_TABLE = {
  ["dd703d"] = 1000,
  ["e61758"] = 5000,
  ["1fafe1"] = 10000,
  ["6d281b"] = 15000
}

--------------------------------------------------
-- DOOR STATE
--------------------------------------------------
local doorState = false

local function openDoor()
  if not doorState then
    redstone.setOutput("left", true)
    doorState = true
  end
end

local function closeDoor()
  if doorState then
    redstone.setOutput("left", false)
    doorState = false
  end
end

closeDoor()

--------------------------------------------------
-- ROOM PRICE CONFIG
--------------------------------------------------
local CONFIG_PRICE_VALUE = nil

local function setRoomPrice()
  term.clear()
  term.setCursorPos(1,1)

  print("SET ROOM PRICE")
  print("1 - 1000")
  print("2 - 5000")
  print("3 - 10000")
  print("4 - 15000")

  local choice = read()

  local map = {
    ["1"] = 1000,
    ["2"] = 5000,
    ["3"] = 10000,
    ["4"] = 15000
  }

  CONFIG_PRICE_VALUE = map[choice]

  print(CONFIG_PRICE_VALUE and "Price set." or "Invalid selection")
  sleep(1)
end

--------------------------------------------------
-- NBT HASH PREFIX (MATCH BANK SYSTEM)
--------------------------------------------------
local function getHashPrefix(inv, slot)
  local item = inv.getItemDetail(slot)
  if not item or not item.nbtHash then return nil end
  return string.sub(item.nbtHash, 1, 6)
end

--------------------------------------------------
-- VALIDATION
--------------------------------------------------
local function isValid(inv, slot)
  local prefix = getHashPrefix(inv, slot)
  if not prefix then return false end

  return PRICE_TABLE[prefix] == CONFIG_PRICE_VALUE
end

--------------------------------------------------
-- CHEST SCAN
--------------------------------------------------
local function scanChest()
  for slot, item in pairs(CHEST.list()) do
    if item then
      return CHEST, slot
    end
  end
  return nil
end

--------------------------------------------------
-- CLEAN INVALID ITEMS
--------------------------------------------------
local function clearInvalidItems()
  for slot, item in pairs(CHEST.list()) do
    if item then
      local prefix = getHashPrefix(CHEST, slot)

      if prefix and not PRICE_TABLE[prefix] then
        CHEST.pushItems(peripheral.getName(TRASH), slot, item.count)
      end
    end
  end
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------
local function runLoop()
  while true do
    clearInvalidItems()

    local inv, slot = scanChest()

    if inv and slot and CONFIG_PRICE_VALUE then
      if isValid(inv, slot) then
        local item = inv.getItemDetail(slot)

        inv.pushItems(peripheral.getName(CHEST), slot, item.count, 1)

        openDoor()
      end
    end

    sleep(0.2)
  end
end

--------------------------------------------------
-- ADMIN MENU
--------------------------------------------------
local function adminMenu()
  while true do
    term.clear()
    term.setCursorPos(1,1)

    print("ROOM CONTROLLER")
    print("----------------")
    print("1 - Open Door")
    print("2 - Close Door")
    print("3 - Set Price")
    print("4 - Exit")

    local input = read()

    if input == "1" then
      openDoor()

    elseif input == "2" then
      closeDoor()

    elseif input == "3" then
      setRoomPrice()

    elseif input == "4" then
      break
    end
  end
end

--------------------------------------------------
-- START
--------------------------------------------------
parallel.waitForAny(
  runLoop,
  adminMenu
)
