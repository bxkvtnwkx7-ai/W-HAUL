-- ==========================================
-- TEKKIT 2 ROOM RENTAL SYSTEM (STABLE BUILD)
-- CC:Tweaked + Advanced Monitor Wall
-- ==========================================

-- CONFIG
local MONITOR_SIDE = "right"
local HOPPER_SIDE = "top"
local RS_SIDE = "back"
local SAVE_FILE = "/room_data.txt"
local PULSE_TIME = 1.5

-- BOOK VALUES (NBT HASHES)
local BOOK_VALUES = {
    ["dd703d"] = 1000,
    ["e61758"] = 5000,
    ["1fafe1"] = 10000,
    ["6d281b"] = 15000
}

-- ROOMS
local ROOMS = {}
for i = 1, 24 do
    ROOMS[i] = {
        value = nil,
        freq = i,
        occupied = false
    }
end

-- MONITOR
local monitor = peripheral.wrap(MONITOR_SIDE)
monitor.setTextScale(0.5)

-- GRID (2x2 ADVANCED WALL AUTO SCALE)
local COLS = 4
local ROWS = 6

local MW, MH = monitor.getSize()
local CELL_W = math.floor(MW / COLS)
local CELL_H = math.floor((MH - 2) / ROWS)

local ROOM_BOUNDS = {}

-- =========================
-- SAVE / LOAD
-- =========================

local function save()
    local f = fs.open(SAVE_FILE, "w")
    f.write(textutils.serialize(ROOMS))
    f.close()
end

local function load()
    if not fs.exists(SAVE_FILE) then return end
    local f = fs.open(SAVE_FILE, "r")
    local data = textutils.unserialize(f.readAll())
    f.close()
    if data then ROOMS = data end
end

-- =========================
-- BOUNDS BUILDER
-- =========================

local function buildBounds()
    local id = 1

    for r = 0, ROWS - 1 do
        for c = 0, COLS - 1 do
            local x1 = (c * CELL_W) + 1
            local y1 = (r * CELL_H) + 3
            local x2 = x1 + CELL_W - 1
            local y2 = y1 + CELL_H - 1

            ROOM_BOUNDS[id] = {x1=x1, y1=y1, x2=x2, y2=y2}
            id = id + 1
        end
    end
end

-- =========================
-- REDSTONE DOOR
-- =========================

local function triggerDoor(freq)
    redstone.setAnalogOutput(RS_SIDE, freq)
    sleep(PULSE_TIME)
    redstone.setAnalogOutput(RS_SIDE, 0)
end

-- =========================
-- ROOM MATCHING
-- =========================

local function findRoom(value)
    for i = 1, 24 do
        local r = ROOMS[i]
        if r.value == value and not r.occupied then
            return i
        end
    end
end

-- =========================
-- DRAW ROOM TILE
-- =========================

local function drawRoom(id)
    local box = ROOM_BOUNDS[id]
    local r = ROOMS[id]

    local cx = math.floor((box.x1 + box.x2) / 2)
    local cy = math.floor((box.y1 + box.y2) / 2)

    monitor.setCursorPos(cx - 1, cy - 1)
    monitor.write(("R%02d"):format(id))

    monitor.setCursorPos(cx - 2, cy)
    monitor.write(r.value and tostring(r.value) or "-")

    monitor.setCursorPos(cx - 3, cy + 1)
    monitor.write(r.occupied and "CLOSED" or "OPEN")
end

local function drawUI()
    monitor.clear()
    monitor.setCursorPos(1,1)
    monitor.write("ROOM CONTROL PANEL")

    for i = 1, 24 do
        drawRoom(i)
    end
end

-- =========================
-- TOUCH DETECTION (FIXED GRID)
-- =========================

local function getRoomFromTouch(x, y)
    for id, box in ipairs(ROOM_BOUNDS) do
        if x >= box.x1 and x <= box.x2 and
           y >= box.y1 and y <= box.y2 then
            return id
        end
    end
end

-- =========================
-- BUTTON DRAW HELPERS
-- =========================

local function drawButton(x1, y1, x2, y2, text)
    for y = y1, y2 do
        monitor.setCursorPos(x1, y)
        monitor.write(string.rep(" ", x2 - x1 + 1))
    end

    local cx = math.floor((x1 + x2) / 2) - math.floor(#text / 2)
    local cy = math.floor((y1 + y2) / 2)

    monitor.setCursorPos(cx, cy)
    monitor.write(text)
end

-- =========================
-- ROOM MENU (FIXED INPUT SYSTEM)
-- =========================

local function roomMenu(id)
    while true do
        local r = ROOMS[id]

        monitor.clear()
        monitor.setCursorPos(1,1)
        monitor.write("ROOM " .. id)

        monitor.setCursorPos(1,3)
        monitor.write("Value: " .. tostring(r.value))
        monitor.setCursorPos(1,4)
        monitor.write("Status: " .. (r.occupied and "CLOSED" or "OPEN"))

        -- VALUE BUTTONS
        drawButton(2, 6, 12, 8, "1000")
        drawButton(14, 6, 24, 8, "5000")

        drawButton(2, 10, 12, 12, "10000")
        drawButton(14, 10, 24, 12, "15000")

        -- ACTION BUTTONS
        drawButton(2, 14, 12, 16, "TOGGLE")
        drawButton(14, 14, 24, 16, "RESET")
        drawButton(2, 18, 24, 20, "BACK")

        local _, _, x, y = os.pullEvent("monitor_touch")

        local function inside(x1,y1,x2,y2)
            return x >= x1 and x <= x2 and y >= y1 and y <= y2
        end

        if inside(2,6,12,8) then
            r.value = 1000

        elseif inside(14,6,24,8) then
            r.value = 5000

        elseif inside(2,10,12,12) then
            r.value = 10000

        elseif inside(14,10,24,12) then
            r.value = 15000

        elseif inside(2,14,12,16) then
            r.occupied = not r.occupied

        elseif inside(14,14,24,16) then
            r.value = nil
            r.occupied = false

        elseif inside(2,18,24,20) then
            save()
            drawUI()
            return
        end

        save()
    end
end

-- =========================
-- HOPPER CHECK
-- =========================

local function checkHopper()
    local inv = peripheral.wrap(HOPPER_SIDE)
    if not inv then return end

    for slot = 1, inv.size() do
        local item = inv.getItemDetail(slot)

        if item and item.nbt then
            local value = BOOK_VALUES[item.nbt]

            if value then
                local room = findRoom(value)

                if room then
                    ROOMS[room].occupied = true
                    triggerDoor(ROOMS[room].freq)
                    save()
                    drawUI()
                end
            end

            break
        end
    end
end

-- =========================
-- MAIN LOOP
-- =========================

load()
buildBounds()
drawUI()

while true do
    local event, side, x, y = os.pullEvent()

    if event == "monitor_touch" then
        local id = getRoomFromTouch(x, y)
        if id then
            roomMenu(id)
            drawUI()
        end
    end

    checkHopper()
    sleep(0.2)
end
