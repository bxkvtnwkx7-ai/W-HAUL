--------------------------------------------------
-- PRICE TABLE (FINGERPRINTS)
--------------------------------------------------
local PRICE_TABLE = {
  ["dd703d"] = 1000,
  ["e61758"] = 5000,
  ["1fafe1"] = 10000,
  ["6d281b"] = 15000
}

--------------------------------------------------
-- INVENTORIES
--------------------------------------------------
local CHEST = nil
local TRASH = nil

local function findInventories()
  local names = peripheral.getNames()
  local invs = {}

  for _, name in ipairs(names) do
    local p = peripheral.wrap(name)
    if p and type(p.list) == "function" then
      table.insert(invs, name)
    end
  end

  if #invs < 2 then
    error("Need at least 2 inventories")
  end

  CHEST = invs[1]
  TRASH = invs[2]
end

findInventories()

--------------------------------------------------
-- DOOR STATE (HOLD OPEN MODE)
--------------------------------------------------
local doorState = false

local function openDoor()
  if not doorState then
    redstone.setOutput("left", true)
    doorState = true
  end
end

local function closeDoor()
  if doorState then
    redstone.setOutput("left", false)
    doorState = false
  end
end

closeDoor()

--------------------------------------------------
-- FINGERPRINT SYSTEM (NO MORE NBT CALLS)
--------------------------------------------------
local fingerprintCache = {}

local function makeFingerprint(item)
  if not item then return nil end

  -- fallback-safe identity system
  local base = textutils.serialize({
    name = item.name,
    count = item.count,
    nbt = item.nbt
  })

  return base
end

--------------------------------------------------
-- PRICE STATE
--------------------------------------------------
local CONFIG_PRICE = nil

local function setRoomPrice()
  term.clear()
  term.setCursorPos(1,1)

  print("SET ROOM PRICE")
  print("1 - 1000")
  print("2 - 5000")
  print("3 - 10000")
  print("4 - 15000")

  local choice = read()

  local map = {
    ["1"] = "dd703d",
    ["2"] = "e61758",
    ["3"] = "1fafe1",
    ["4"] = "6d281b"
  }

  CONFIG_PRICE = map[choice]

  print(CONFIG_PRICE and "Price set." or "Invalid selection")
  sleep(1)
end

--------------------------------------------------
-- CHEST SCAN (SAFE)
--------------------------------------------------
local function scanChest()
  local inv = peripheral.wrap(CHEST)
  if not inv then return nil end

  for slot, item in pairs(inv.list()) do
    if item then
      return inv, slot, item
    end
  end

  return nil
end

--------------------------------------------------
-- VALIDATION (FINGERPRINT BASED)
--------------------------------------------------
local function getItemKey(item)
  local fp = makeFingerprint(item)

  if not fingerprintCache[fp] then
    fingerprintCache[fp] = true
  end

  return fp
end

local function isValid(item)
  local key = getItemKey(item)
  return key == CONFIG_PRICE
end

--------------------------------------------------
-- AUTO CLEAN (SAFE)
--------------------------------------------------
local function clearInvalidItems()
  local inv = peripheral.wrap(CHEST)
  if not inv then return end

  for slot, item in pairs(inv.list()) do
    if item then
      local key = getItemKey(item)

      if key
        and key ~= CONFIG_PRICE
        and not PRICE_TABLE[key] then

        inv.pushItems(TRASH, slot, item.count)
      end
    end
  end
end

--------------------------------------------------
-- MAIN LOOP (ZERO NBT CALLS)
--------------------------------------------------
local function runLoop()
  while true do
    clearInvalidItems()

    local inv, slot, item = scanChest()

    if inv and slot and item and CONFIG_PRICE then
      if isValid(item) then

        inv.pushItems(CHEST, slot, item.count, 1)
        openDoor()
      end
    end

    sleep(0.2)
  end
end

--------------------------------------------------
-- ADMIN MENU
--------------------------------------------------
local function adminMenu()
  while true do
    term.clear()
    term.setCursorPos(1,1)

    print("ROOM CONTROLLER")
    print("----------------")
    print("1 - Open Door")
    print("2 - Close Door")
    print("3 - Set Price")
    print("4 - Exit")

    local input = read()

    if input == "1" then
      openDoor()

    elseif input == "2" then
      closeDoor()

    elseif input == "3" then
      setRoomPrice()

    elseif input == "4" then
      break
    end
  end
end

--------------------------------------------------
-- START
--------------------------------------------------
parallel.waitForAny(
  runLoop,
  adminMenu
)
