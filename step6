--==================================================
-- STEP SEQUENCER DAW v1
-- CC:Tweaked 1.89.2
--
-- monitor_983 → UI GRID
-- speaker_347 → AUDIO OUTPUT
--==================================================

--========================
-- PERIPHERALS
--========================

local mon = peripheral.wrap("monitor_983")
local speaker = peripheral.wrap("speaker_347")

if not mon then error("monitor_983 missing") end
if not speaker then error("speaker_347 missing") end

--========================
-- SETTINGS
--========================

local STEPS = 32
local ROWS = 30

local BPM = 120
local stepTime = 60 / BPM / 2

--========================
-- NOTES (2.5 OCTAVES)
--========================

local notes = {
    {"C3",130.81},{"C#3",138.59},{"D3",146.83},{"D#3",155.56},{"E3",164.81},
    {"F3",174.61},{"F#3",185.00},{"G3",196.00},{"G#3",207.65},{"A3",220.00},
    {"A#3",233.08},{"B3",246.94},

    {"C4",261.63},{"C#4",277.18},{"D4",293.66},{"D#4",311.13},{"E4",329.63},
    {"F4",349.23},{"F#4",369.99},{"G4",392.00},{"G#4",415.30},{"A4",440.00},
    {"A#4",466.16},{"B4",493.88},

    {"C5",523.25},{"C#5",554.37},{"D5",587.33},{"D#5",622.25},{"E5",659.25},
    {"F5",698.46}
}

-- grid[row][step]
local grid = {}

for r=1,#notes do
    grid[r] = {}
    for s=1,STEPS do
        grid[r][s] = false
    end
end

--========================
-- STATE
--========================

local playing = false
local currentStep = 1

--========================
-- DRAW UI
--========================

local function draw()

    mon.setBackgroundColor(colors.black)
    mon.clear()

    -- Header
    mon.setBackgroundColor(colors.blue)
    mon.setTextColor(colors.white)
    mon.setCursorPos(1,1)
    mon.write(" STEP DAW | SPACE=PLAY ")

    for r=1,#notes do

        mon.setCursorPos(1,r+1)

        local name = notes[r][1]

        mon.setTextColor(colors.white)
        mon.write(name .. string.rep(" ", 4))

        for s=1,STEPS do

            if grid[r][s] then

                if s == currentStep and playing then
                    mon.setBackgroundColor(colors.yellow)
                else
                    mon.setBackgroundColor(colors.green)
                end

            else

                if s == currentStep and playing then
                    mon.setBackgroundColor(colors.orange)
                else
                    mon.setBackgroundColor(colors.gray)
                end
            end

            mon.write(" ")
        end
    end
end

--========================
-- AUDIO ENGINE
--========================

local function playNote(freq)

    -- fake pad layering using harp notes
    speaker.playNote("harp", 1, freq / 440 * 24)
    speaker.playNote("bell", 0.6, freq / 440 * 24)
end

local function playStep(step)

    for r=1,#notes do

        if grid[r][step] then
            playNote(notes[r][2])
        end
    end
end

--========================
-- PLAYBACK LOOP
--========================

local function playback()

    while playing do

        playStep(currentStep)
        draw()

        currentStep = currentStep + 1
        if currentStep > STEPS then
            currentStep = 1
        end

        sleep(stepTime)
    end
end

--========================
-- INPUT LOOP
--========================

draw()

local function input()

    while true do

        local e, side, x, y = os.pullEvent("monitor_touch")

        if y == 1 then
            playing = not playing

            if playing then
                parallel.waitForAny(playback, input)
            end

        else

            local row = y - 1
            local step = math.floor((x - 6))

            if grid[row] and grid[row][step] ~= nil then
                grid[row][step] = not grid[row][step]
                draw()
            end
        end
    end
end

input()
